# ==============================
# SUPABASE
# ==============================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_JWT_SECRET=

# ==============================
# CLOUDINARY
# ==============================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=gymos_unsigned

# ==============================
# AUTH PROVIDERS
# ==============================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ==============================
# EMAIL (Resend primary, Gmail SMTP fallback)
# ==============================
# Resend -- primary provider. Requires a verified sending domain (SPF/DKIM/
# DMARC) in the Resend dashboard for reliable inbox placement.
RESEND_API_KEY=
EMAIL_FROM=GymOS <no-reply@gymos.app>

# Gmail SMTP -- optional fallback, used automatically if RESEND_API_KEY is
# not set, or if a Resend send fails. Requires a Gmail account with 2-Step
# Verification and an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords) -- a normal Gmail password will NOT work.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=GymOS

# ==============================
# WHATSAPP / SMS (Twilio)
# ==============================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# ==============================
# WHATSAPP CLOUD API (Meta) -- subscription purchase/expiry alerts only
# ==============================
# Get these from developers.facebook.com -> your app -> WhatsApp -> API Setup.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0
# Optional: once approved in Meta Business Manager, switch these alerts from
# plain text to Message Templates (required in production, see
# lib/services/whatsapp-cloud.ts for details).
WHATSAPP_SUBSCRIPTION_CONFIRMED_TEMPLATE=
WHATSAPP_SUBSCRIPTION_EXPIRED_TEMPLATE=

# ==============================
# PUSH NOTIFICATIONS
# ==============================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ==============================
# AI (Anthropic Claude)
# ==============================
ANTHROPIC_API_KEY=

# ==============================
# PAYMENTS
# ==============================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ==============================
# ATTENDANCE
# ==============================
QR_SECRET=

# ==============================
# APP
# ==============================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GymOS
CRON_SECRET=
